# Postgres (matches docker-compose.yml by default)
DATABASE_URL=postgres://buddywize:buddywize_dev@localhost:15432/buddywize

# HTTP server
HOST=0.0.0.0
PORT=7878

# JWT
#   Rotate in production. Tokens issued before a rotation are rejected.
JWT_SECRET=change-me-in-production

# Object storage.
#
#   Local filesystem (default for dev / single-node):
#     STORAGE_DIR=.storage
#
#   Cloudflare R2 (recommended for production):
#     Set R2_BUCKET along with the credentials below; STORAGE_DIR is ignored.
#     Find the Account ID and create an R2 API token in the Cloudflare dashboard:
#     https://dash.cloudflare.com/?to=/:account/r2/overview
#
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=buddywize-audio
STORAGE_DIR=.storage

# Speech-to-text (faster-whisper).
#
#   WHISPER_MODEL=disabled  -> use the deterministic mock provider (no Python)
#   WHISPER_MODEL=large-v3   -> faster-whisper with OpenAI's whisper-large-v3
#                              (best open-source ASR as of 2026; ~3 GB download)
#   Other valid values: medium, small, base, tiny, distil-large-v3, ...
#
#   The Python script lives at bin/transcribe.py by default; WHISPER_PYTHON
#   and WHISPER_SCRIPT override the interpreter and script path.
#
# WHISPER_MODEL=large-v3
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8
# WHISPER_BEAM_SIZE=5

# Default admin seeded on first boot (idempotent).
ADMIN_EMAIL=admin@buddywize.local
ADMIN_PASSWORD=admin-buddywize

# Logging
RUST_LOG=buddywize=debug,tower_http=info
